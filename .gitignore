# Local .terraform directory (contains binaries and modules)
.terraform/

# .tfstate files (contains sensitive infra data and secrets)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files (likely contain sensitive secrets/passwords)
*.tfvars
*.tfvars.json

# Override files (used for local-only adjustments)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc
